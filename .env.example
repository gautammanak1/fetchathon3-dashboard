# Notion roster (source of truth). The dashboard talks to Notion, not the agent.

NOTION_TOKEN=
NOTION_DATABASE_ID=
# NOTION_DATABASE_URL=
NOTION_VERSION=2022-06-28

# Admin login. Shared dashboard links stay view-only without this session.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional durable mail log (who got registration / RSVP / QR).
# Locally this is .data/mail-db.json. On Vercel, add a Blob store so
# status survives deploys — disk is ephemeral without this token.
BLOB_READ_WRITE_TOKEN=

# SMTP for RSVP seat confirmation and team venue QR emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=innovationlab@fetch.ai
SMTP_PASSWORD=
SMTP_FROM=innovationlab@fetch.ai
SMTP_FROM_NAME=Fetch-A-Thon
SMTP_TIMEOUT_SECONDS=20
SMTP_TEST_TO=gautammanak1@gmail.com
FETCHATHON_DISCORD_URL=https://discord.gg/fetchai
NEXT_PUBLIC_APP_URL=http://localhost:3000
FETCHATHON_EVENT_URL=https://innovationlab.fetch.ai/events/fetch-a-thon-3
FETCHATHON_EMAIL_BANNER_URL=https://res.cloudinary.com/fetch-ai/image/upload/v1790604758/golden-agents/X_4_tswsoe.png

# Optional: override Notion column names if they differ from defaults
# NOTION_FIELDS={"name":"Name","address":"Address","email":"Email","phone":"Phone","role":"Role","team_id":"Team ID","participation":"Participation","are_you":"Are you","organization":"Organization","city":"City","skills":"Skills","experience":"Experience","github":"GitHub","linkedin":"LinkedIn","team_size":"Team size","registered_count":"Registered count","seats_remaining":"Seats remaining","team_status":"Team status","status":"Status"}
